#!/usr/bin/env bash
# Fuzzy-select ~/code/<user>/<repository> and focus/create a matching Herdr workspace.
# Workspace labels use the stable, collision-resistant form <user>/<repository>.

set -Eeuo pipefail

CODE_ROOT="${HERDR_CODE_ROOT:-$HOME/code}"
HERDR_BIN="${HERDR_BIN_PATH:-herdr}"

usage() {
  cat <<'USAGE'
Usage: herdr-sessionizer [REPOSITORY_PATH]

Without an argument, choose a repository with fzf from:
  $HERDR_CODE_ROOT (defaults to ~/code), exactly two directory levels deep.

With an argument, use that repository path directly.

Dependencies: herdr, fzf, jq
USAGE
}

fail() {
  printf 'herdr-sessionizer: %s\n' "$*" >&2
  exit 1
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

if (( $# > 1 )); then
  usage >&2
  exit 2
fi

command -v "$HERDR_BIN" >/dev/null 2>&1 || fail "cannot find Herdr CLI: $HERDR_BIN"
command -v jq >/dev/null 2>&1 || fail "jq is required to inspect Herdr workspaces"

if ! command -v fzf >/dev/null 2>&1 && (( $# == 0 )); then
  fail "fzf is required to choose a repository"
fi

if ! code_root="$(cd -- "$CODE_ROOT" 2>/dev/null && pwd -P)"; then
  fail "repository root does not exist or is not accessible: $CODE_ROOT"
fi

if (( $# == 1 )); then
  selected="$1"
else
  # Keep the original sessionizer's discovery rule: ~/code/<user>/<repository>.
  # Do not include paths deeper than two levels, and skip a directory named venv.
  # NUL delimiters preserve repository paths containing spaces or unusual characters.
  if ! IFS= read -r -d '' selected < <(
    find "$code_root" \
      -mindepth 2 -maxdepth 2 \
      -type d \
      ! -path '*/venv' \
      -print0 2>/dev/null |
      fzf \
        --read0 \
        --print0 \
        --prompt='repository> ' \
        --layout=reverse \
        --border \
        --header='Select ~/code/<user>/<repository>' \
        --preview='git -C {} status --short --branch 2>/dev/null || ls -la {}' \
        --preview-window='right:40%:wrap'
  ); then
    # fzf returns no selection when the user presses Escape/Ctrl-C.
    exit 0
  fi
fi

[[ -n "$selected" ]] || exit 0

if ! selected="$(cd -- "$selected" 2>/dev/null && pwd -P)"; then
  fail "selected path does not exist or is not accessible: $selected"
fi

# Require the requested structure. This also prevents accidental creation of
# workspaces for arbitrary paths passed as an argument.
case "$selected" in
  "$code_root"/*) relative_path="${selected#"$code_root"/}" ;;
  *) fail "repository must be inside $code_root: $selected" ;;
esac

# Split relative path into exactly two directory components: user/repository.
IFS='/' read -r owner repository extra <<< "$relative_path"
if [[ -z "${owner:-}" || -z "${repository:-}" || -n "${extra:-}" ]]; then
  fail "expected a path shaped like $code_root/<user>/<repository>: $selected"
fi

workspace_label="$owner/$repository"

# workspace list returns a JSON response with result.workspaces[].workspace_id
# and result.workspaces[].label. Existing workspaces are focused rather than duplicated.
if ! workspace_json="$("$HERDR_BIN" workspace list)"; then
  fail "could not query Herdr workspaces; is the Herdr server running?"
fi

if ! workspace_id="$(jq -er --arg label "$workspace_label" '
  [.result.workspaces[]? | select(.label == $label) | .workspace_id][0] // empty
' <<< "$workspace_json" 2>/dev/null)"; then
  workspace_id=""
fi

if [[ -n "$workspace_id" ]]; then
  "$HERDR_BIN" workspace focus "$workspace_id" >/dev/null ||
    fail "found workspace '$workspace_label' ($workspace_id), but could not focus it"
  exit 0
fi

# New workspace: label identifies the owner and repository; cwd points at the checkout.
"$HERDR_BIN" workspace create \
  --cwd "$selected" \
  --label "$workspace_label" \
  --focus >/dev/null ||
  fail "could not create workspace '$workspace_label' at $selected"
